kwic_gdex <- Map(function(asdf){
  kwic(toks_kwic, pattern = c(asdf), window = 999)
},
asdf = kwic_tag)

episodes <- tibble(
  docname = docnames(toks_kwic),
  season = docvars(toks_kwic, "season"),
  episode = docvars(toks_kwic, "episode")
)




GDEX_list <- lapply(kwic_gdex, function(f){
  if (is.null(f) || nrow(f) == 0) return(tibble())
  matched_rows <- match(f$doc, docnames(toks_kwic))
  as_tibble(f) %>%
    left_join(episodes, by = "docname") %>%
    mutate(
      ejemplo = paste(pre, keyword, post),
      score = map_dbl(ejemplo, score_example)
    ) %>%
    select(
      ejemplo,
      season,
      episode,
      docname,
      start_pos = from,
      score
    ) %>%
    arrange(desc(score))
})



