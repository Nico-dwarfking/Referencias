#GDEX
setwd("...")
freq_list_ESP <- read.csv("SUBTLEX-ESP.csv", header = T, row.names = NULL, sep = ";", 
                          encoding = "UTF-8") %>% 
  select(Word, Freq..per.million) %>% 
  mutate(Word = str_to_lower(Word))

freq_lookup <- setNames(freq_list_ESP$Freq..per.million, freq_list_ESP$Word)

score_example <- function(sentence) {
  tokens <- str_split(str_to_lower(sentence), "\\s+")[[1]]
  tokens <- str_replace_all(tokens, "[[:punct:]]", "")
  tokens <- tokens[tokens != ""]
  len <- length(tokens)
  length_score <- ifelse(len >= 8 & len <= 20, 1, 0)
  freq_vals <- freq_lookup[tokens]
  freq_vals_num <- suppressWarnings(as.numeric(freq_vals))
  freq_vals_num[is.na(freq_vals_num)] <- 0.01
  freq_score <- mean(log10(freq_vals_num + 1))
  symbol_penalty <- ifelse(str_detect(sentence, "[^\\wáéíóúüñÁÉÍÓÚÜÑ\\s.,]"), -0.5, 0)
  total <- length_score + freq_score + symbol_penalty
  return(total)
}

#Path to data
setwd("...")
options(max.print = 900000)

raw_data <- readtext("S*/*.txt", 
                     docvarsfrom = "filepath", 
                     dvsep = "/", 
                     docvarnames = c("season", "episode"))

raw_data$episode <- gsub(".txt", "", raw_data$episode)

subs <- raw_data[, c("season", "episode", "text")]

Corpus <- corpus(subs, text_field = "text")

toks_clean <- tokens(Corpus, remove_punct = T, remove_symbols = F, 
                     remove_numbers = T, remove_url = T, include_docvars = T, padding = F)%>%
  tokens_remove(pattern = stopwords("en", source = "stopwords-iso"), padding = T)%>%
  tokens_remove (pattern = c("Previously on RuPaul's Drag Race", "phi", "chi")) %>% 
  tokens_remove (pattern = "\\[.*?\\]", valuetype = "regex") %>% 
  tokens_keep(pattern = "^[\\p{script=Latn}]+$", valuetype = "regex")

Corpus_kwic <- corpus_reshape(Corpus, to = "sentences")

toks_kwic <- tokens(Corpus_kwic, remove_punct = FALSE)

dfmat_kwic <- dfm(toks_kwic)
dfmat_clean <- dfm(toks_clean)

seasons <- sprintf("S%02d", 1:16)

