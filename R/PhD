Tags <- c("Elles", "Ellxs", "Twitter", "Bsky", "Total")

add_subcorpus <- function(df_list, tags = Tags) {
  tag_map <- setNames(tags, paste0("Corpus_", tags))
  for (name in names(df_list)) {
    if (name %in% names(tag_map)) {
      df_list[[name]]$Subcorpus <- tag_map[name]
    }
  }
  return(df_list)
}

